<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Count-dependent strings. Translations add the plural categories their language needs. -->
<plist version="1.0">
<dict>
	<key>%ld Screenshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld Screenshot</string>
			<key>other</key>
			<string>%ld Screenshots</string>
		</dict>
	</dict>
	<key>%ld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld image</string>
			<key>other</key>
			<string>%ld images</string>
		</dict>
	</dict>
	<key>After %ld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>After %ld minute</string>
			<key>other</key>
			<string>After %ld minutes</string>
		</dict>
	</dict>
	<key>Pins prevent expiration. Dragging creates a temporary PNG that is deleted after %ld minutes. Everything is discarded when you quit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Pins prevent expiration. Dragging creates a temporary PNG that is deleted after %#@minutes@. Everything is discarded when you quit.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld minute</string>
			<key>other</key>
			<string>%ld minutes</string>
		</dict>
	</dict>
	<key>SnapPile, %ld screenshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>SnapPile, %ld screenshot</string>
			<key>other</key>
			<string>SnapPile, %ld screenshots</string>
		</dict>
	</dict>
</dict>
</plist>
